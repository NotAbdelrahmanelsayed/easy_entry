      "error_message": "Item Manager SPA shows 'Failed to load items' with a Retry button",
      "file": "frontend/src/pages/ItemManager.vue",
      "root_cause": "The /item-manager www page is public (not auth-gated) so a logged-out visitor can open it, but every whitelisted API call (get_items) then returns PermissionError. The SPA rendered a dead-end error state instead of routing to login.",
